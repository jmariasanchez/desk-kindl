# Copy to config/env and fill in. Sourced by every script.

# Google Calendar: Settings > your calendar > Integrate calendar > Secret address in iCal format.
# Keep this link private. Downloaded every 15 minutes; cached for offline use.
# Set the clock/agenda timezone in dashboard.conf.
ICAL_URL=""

# Weather: city name or lat,lon for wttr.in
WEATHER_LOCATION="London"

# Transit: any URL returning plain text or JSON departures.
# Default uses transport.rest style APIs (v6.db.transport.rest / v6.vbb.transport.rest).
TRANSIT_URL=""
TRANSIT_LIMIT=6


# Home server: hosts to ping and URLs to health-check (space separated)
SERVER_HOSTS="192.168.1.10"
SERVER_URLS="http://192.168.1.10:8080/health"
